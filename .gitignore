# 虚拟环境（本机自用，不随仓库分发）
.venv/
.venv-*/

# 运行期数据：平台库、快照、日志都在本机，入库会污染历史
data/platform.db
data/platform.db.bak-*
data/platform.db-journal
data/platform.db-wal
data/platform.db-shm
data/state-cache/
data/logs/

# Python / Node 缓存
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
node_modules/

# 编辑器 / 系统
.DS_Store
.vscode/
*.swp

# 访问令牌（远端鉴权用）：绝不能入库
data/token
data/token.bak-*
